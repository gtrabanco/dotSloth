{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "$PWD"
      ],
      "exposure": "codemode"
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "exposure": "codemode"
    },
    "github": {
      "exposure": "codemode"
    },
    "gitmcp-docs": {
      "url": "https://gitmcp.io/docs",
      "exposure": "codemode"
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project-from-cwd"
      ],
      "exposure": "codemode"
    }
  }
}
